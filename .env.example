# Don't edit this file directly for API keys -- run:
#   python -m cognitive_rpg.settings_wizard
# It writes into .env (never commit .env) and picks the provider/model/key for you.
# This file is only the starting template it copies from and the reference for
# what each variable means.

# Which provider powers each role. One of: claude | gemini | gemini_vertex | openai | mock
# "mock" = no network calls, $0 cost, no key needed -- the safe default.
# "gemini_vertex" = same Gemini models as "gemini", but billed through a GCP
# project via Vertex AI / Agent Platform instead of an AI Studio API key -- use
# this one if you want usage to draw on Google Cloud billing credits (AI Studio
# API keys are excluded from those credits as of March 2026).
EXPERT_PROVIDER=mock
SMALL_PROVIDER=mock

ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Only used by the gemini_vertex provider -- set via the settings wizard, not by
# hand, so the service account key path never has to be typed anywhere but here.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=

# Optional model overrides -- leave blank to use each provider's default
# (see cognitive_rpg/providers.py). Verify these against each provider's current
# docs before trusting them; only the Claude default is confirmed by a loaded skill.
CLAUDE_MODEL=
GEMINI_MODEL=
OPENAI_MODEL=

# If EXPERT_PROVIDER and SMALL_PROVIDER are the same, the shared *_MODEL var above
# can't give the two roles different models. Use a role-specific override instead
# (checked first by adapters/factory.py), e.g.:
#   EXPERT_GEMINI_MODEL=gemini-3.5-flash
#   SMALL_GEMINI_MODEL=gemini-3.5-flash-lite
# Same pattern works for any provider: EXPERT_CLAUDE_MODEL, SMALL_OPENAI_MODEL, etc.

# Pricing in USD per 1,000,000 tokens, used only for cost tracking in the experiment log.
# Claude prices below are from the claude-api skill (cached 2026-06-24) -- re-check if it's been a while.
CLAUDE_OPUS_5_INPUT_PER_MTOK=5.00
CLAUDE_OPUS_5_OUTPUT_PER_MTOK=25.00
CLAUDE_SONNET_5_INPUT_PER_MTOK=3.00
CLAUDE_SONNET_5_OUTPUT_PER_MTOK=15.00
CLAUDE_HAIKU_4_5_INPUT_PER_MTOK=1.00
CLAUDE_HAIKU_4_5_OUTPUT_PER_MTOK=5.00

# No verified default for Gemini/OpenAI -- fill these in yourself (or via the
# settings wizard, which will remind you) before trusting cost numbers for them.
GEMINI_INPUT_PER_MTOK=
GEMINI_OUTPUT_PER_MTOK=
OPENAI_INPUT_PER_MTOK=
OPENAI_OUTPUT_PER_MTOK=
